SERVER_NAME=
CHECK_INTERVAL_MINUTES=60
MAIL_LOG_PATH=/var/log/mail.log
VHOSTS_PATH=/var/www/vhosts
RECENT_FILE_HOURS=24
# Komma-getrennte zusätzliche Pfad-Fragmente, die beim Datei-Scan ignoriert werden.
# Standardmäßig bereits ignoriert: /wp-content/wflogs/, /wp-content/uploads/cache/
SUSPICIOUS_FILES_EXCLUDE=
# Komma-getrennte Plugin-Slugs, die als bekannter Plugin-Code niedriger bewertet werden.
# Kritische Muster wie eval(base64_decode()), POST/GET-Command-Execution oder Upload-PHP bleiben kritisch.
SUSPICIOUS_FILES_TRUSTED_PLUGINS=
# Komma-getrennte Pfad-Fragmente fuer bekannte Dateien, die nur abgewertet, aber nicht ignoriert werden.
SUSPICIOUS_FILES_TRUSTED_FILES=

# MySQL Datenbank
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=server_watchdog

# Web-Dashboard
WEB_PORT=3000
WEB_HOST=127.0.0.1
WEB_USER=admin
WEB_PASS=

# KI-Review (optional, nur bei MEDIUM+)
ENABLE_AI_REVIEW=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
AI_REVIEW_MIN_RISK=medium
AI_NOTIFY_MIN_RISK=high
AI_NOTIFY_COOLDOWN_MINUTES=360

# E-Mail Benachrichtigung (optional)
ENABLE_EMAIL_NOTIFIER=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Telegram Benachrichtigung (optional)
ENABLE_TELEGRAM_NOTIFIER=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
